<Project Sdk="Microsoft.NET.Sdk.Worker">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>NSA.Worker</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="8.0.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../notification-api/NSA.csproj" />
    <ProjectReference Include="../notification.worker.shared/NSA.Worker.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="../notification.worker.shared/appsettings.json">
      <Link>appsettings.json</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <!-- NSA is a code dependency, but its Web-host settings must not replace the
       worker defaults linked above when this executable is published. -->
  <Target Name="RemoveApiHostSettingsFromWorkerPublish" AfterTargets="ComputeFilesToPublish">
    <ItemGroup>
      <ResolvedFileToPublish Remove="$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)/../notification-api/appsettings.json'))" />
    </ItemGroup>
  </Target>

</Project>
