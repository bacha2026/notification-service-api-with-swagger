{
  "ConnectionStrings": {
    "NotificationDb": "Server=.;Database=NotificationServiceDb;Trusted_Connection=True;TrustServerCertificate=True;MultipleActiveResultSets=true;Connect Timeout=2;ConnectRetryCount=0"
  },
  "Database": {
    "ApplyMigrationsOnStartup": false
  },
  "Release": {
    "Color": "local",
    "Sha": "development"
  },
  "ReverseProxy": {
    "TrustForwardedHeaders": false
  },
  "Authentication": {
    "MaxFailedAccessAttempts": 5,
    "LockoutMinutes": 15,
    "Jwt": {
      "Issuer": "NSA.NotificationService",
      "Audience": "NSA.NotificationClient",
      "AccessTokenLifetimeMinutes": 15
    }
  },
  "PasswordReset": {
    "FrontendUrl": "http://localhost:3000",
    "Smtp": {
      "Host": "",
      "Port": 587,
      "EnableSsl": true,
      "From": "",
      "UserName": "",
      "Password": ""
    }
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:3000",
      "http://127.0.0.1:3000"
    ]
  },
  "NotificationEmails": {
    "DefaultVisitorEmail": "visitor@example.test"
  },
  "BulkNotifications": {
    "MaxTrackedJobs": 1000,
    "MaxBatchSize": 100,
    "CompletedJobRetentionMinutes": 60
  },
  "Durability": {
    "IdempotencyRetentionHours": 24
  },
  "RabbitMq": {
    "Enabled": false,
    "HostName": "localhost",
    "Port": 5672,
    "UserName": "",
    "Password": "",
    "VirtualHost": "/",
    "CommandExchange": "nsa.notifications.commands.v1",
    "CommandQueue": "nsa.notifications.bulk.v1",
    "CommandRoutingKey": "bulk.requested.v1",
    "RetryExchange": "nsa.notifications.retry",
    "RetryQueue": "nsa.notifications.bulk.retry",
    "RetryRoutingKey": "bulk.retry.v1",
    "DeadLetterExchange": "nsa.notifications.dead-letter",
    "DeadLetterQueue": "nsa.notifications.bulk.dlq",
    "DeadLetterRoutingKey": "bulk.dead-letter.v1",
    "MaxDeliveryAttempts": 3,
    "RetryDelayMilliseconds": 5000,
    "MaximumRetryDelayMilliseconds": 300000,
    "PrefetchCount": 1,
    "NetworkRecoverySeconds": 5,
    "RequestedHeartbeatSeconds": 30,
    "FailureInjectionSubject": null
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "HttpsRedirection": {
    "Enabled": true
  },
  "AllowedHosts": "*"
}
