{
  "ConnectionStrings": {
    "NotificationDb": "Server=.;Database=NotificationServiceDb;Trusted_Connection=True;TrustServerCertificate=True;MultipleActiveResultSets=true;Connect Timeout=2;ConnectRetryCount=0"
  },
  "Database": {
    "ApplyMigrationsOnStartup": true
  },
  "NotificationEmails": {
    "AdminEmail": "admin@example.test",
    "DefaultVisitorEmail": "visitor@example.test"
  },
  "Postbound": {
    "BaseUrl": "https://api.postbound.com/",
    "ApiKey": "",
    "Enabled": false,
    "RequestTimeoutSeconds": 10,
    "RetryCount": 3,
    "InitialRetryDelayMilliseconds": 200,
    "CircuitBreakerFailures": 3,
    "CircuitBreakDurationSeconds": 30
  },
  "BulkNotifications": {
    "MaxTrackedJobs": 1000,
    "MaxBatchSize": 100,
    "CompletedJobRetentionMinutes": 60
  },
  "RabbitMq": {
    "HostName": "localhost",
    "Port": 5672,
    "UserName": "",
    "Password": "",
    "VirtualHost": "/",
    "CommandExchange": "nsa.notifications.commands.v1",
    "CommandQueue": "nsa.notifications.bulk.v1",
    "CommandRoutingKey": "bulk.requested.v1",
    "DeadLetterExchange": "nsa.notifications.dead-letter",
    "DeadLetterQueue": "nsa.notifications.bulk.dlq",
    "DeadLetterRoutingKey": "bulk.dead-letter.v1",
    "MaxDeliveryAttempts": 3,
    "BrokerDeliveryLimit": 20,
    "PrefetchCount": 1,
    "InitialConnectionRetrySeconds": 5,
    "NetworkRecoverySeconds": 5,
    "ConnectionTimeoutSeconds": 2,
    "RequestedHeartbeatSeconds": 30,
    "FailureInjectionSubject": null
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "HttpsRedirection": {
    "Enabled": true
  },
  "AllowedHosts": "*"
}
