<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <RootNamespace>NSA</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="8.0.18" />
    <PackageReference Include="Polly" Version="7.2.4" />
    <PackageReference Include="RabbitMQ.Client" Version="7.2.1" />
    <PackageReference Include="Polly.Contrib.WaitAndRetry" Version="1.1.1" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="../notification-api/Application/**/*.cs" Link="Application/%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="../notification-api/Common/**/*.cs" Link="Common/%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="../notification-api/Domain/**/*.cs" Link="Domain/%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="../notification-api/Infrastructure/**/*.cs" Link="Infrastructure/%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="../notification-api/Persistence/**/*.cs" Link="Persistence/%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="../notification-api/Service/**/*.cs" Link="Service/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Microsoft.AspNetCore.Http" />
    <Using Include="Microsoft.Extensions.Configuration" />
    <Using Include="Microsoft.Extensions.DependencyInjection" />
    <Using Include="Microsoft.Extensions.Logging" />
  </ItemGroup>

</Project>
